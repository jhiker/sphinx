{
  "name": "sphinx-cli",
  "version": "1.0.0",
  "description": "JSON-based quiz system for measuring technical competence",
  "type": "module",
  "main": "dist/cli.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "bin": {
    "sphinx": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhiker/sphinx.git"
  },
  "homepage": "https://github.com/jhiker/sphinx#readme",
  "bugs": {
    "url": "https://github.com/jhiker/sphinx/issues"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc && cp -r src/schema dist/ && cp -r templates dist/ && cp -r skills dist/",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node --test $(find dist -name '*.test.js' -type f)",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "quiz",
    "assessment",
    "irt",
    "adaptive-testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.47",
    "ajv": "^8.12.0",
    "commander": "^12.0.0",
    "esbuild": "^0.20.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/prompts": "^2.4.9",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.25.0"
  }
}
